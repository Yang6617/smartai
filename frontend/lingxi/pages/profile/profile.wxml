<!-- pages/profile/profile.wxml -->
<view class="container">
  <view class="profile-header">
    <view class="avatar">
      <text class="avatar-text">👤</text>
    </view>
    <view class="user-info">
      <text class="nickname">{{userInfo.nickName || '未登录用户'}}</text>
      <text class="desc">灵析知识库用户</text>
    </view>
  </view>

  <view class="profile-content">
    <view class="menu-list">
      <view class="menu-item" bindtap="manageFiles">
        <text class="menu-icon">📁</text>
        <text class="menu-text">文件管理</text>
        <text class="arrow">></text>
      </view>
      
      <view class="menu-item" bindtap="shareKnowledgeBase">
        <text class="menu-icon">🔗</text>
        <text class="menu-text">分享知识库</text>
        <text class="arrow">></text>
      </view>
      
      <view class="menu-item" bindtap="manageAccount">
        <text class="menu-icon">⚙️</text>
        <text class="menu-text">账号设置</text>
        <text class="arrow">></text>
      </view>
    </view>

    <button class="logout-btn" bindtap="logout">
      退出登录
    </button>
  </view>
</view>