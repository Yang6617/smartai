/* pages/qna/qna.wxss */
page {
  height: 100%;
  background-color: #f5f5f5;
}

.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
}

/* 固定顶部模块：知识库信息 */
.fixed-header {
  position: sticky;
  top: 0;
  z-index: 100;
  padding: 20rpx;
  background-color: white;
  border-bottom: 1rpx solid #eee;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.knowledge-info {
  flex: 1;
}

.kb-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  display: block;
}

.kb-desc {
  font-size: 32rpx;
  color: #666;
  margin-top: 10rpx;
}

/* 可滚动的中间内容区域 */
.scrollable-content {
  flex: 1;
  padding: 30rpx;
  box-sizing: border-box;
  height: calc(100vh - 220rpx); /* 减去顶部和底部固定区域的高度 */
}

.messages {
  min-height: 100%;
}

.message-item {
  margin-bottom: 30rpx;
  animation: fadeInUp 0.3s ease-out;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.message-header {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.message-role {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-right: 20rpx;
  white-space: nowrap;
}

.divider {
  flex: 1;
  height: 1rpx;
  background-color: #e0e0e0;
}

.message-content {
  background-color: #f8f9fa;
  padding: 20rpx 25rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  line-height: 1.6;
  color: #333;
  border-left: 6rpx solid #3cc51f;
}

.user-message .message-content {
  background-color: #e3f2fd;
  border-left: 6rpx solid #2196f3;
}

.assistant-message .message-content {
  background-color: #f8f9fa;
  border-left: 6rpx solid #4caf50;
}

/* 固定底部模块：输入区域 */
.fixed-input-area {
  position: sticky;
  bottom: 0;
  z-index: 100;
  padding: 30rpx;
  background-color: white;
  border-top: 1rpx solid #eee;
  display: flex;
  align-items: flex-end;
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.1);
}

.input {
  flex: 1; /* 占据大部分剩余空间 */
  background-color: #f8f9fa;
  border: 1rpx solid #e0e0e0;
  border-radius: 16rpx;
  padding: 25rpx 30rpx;
  min-height: 120rpx;
  max-height: 300rpx;
  overflow-y: auto;
  font-size: 32rpx;
  margin-right: 15rpx;
  white-space: normal;
}

.input::placeholder {
  color: #aaa;
  white-space: nowrap;
}

.send-btn {
  flex: 0 0 auto; /* 自动适应宽度 */
  background-color: #3cc51f;
  color: white;
  border: none;
  border-radius: 32rpx; /* 圆角矩形 */
  width: 80rpx; /* 缩小宽度 */
  height: 60rpx; /* 调整高度 */
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx; /* 调整字体大小 */
  min-width: 80rpx;
  align-self: flex-end; /* 靠右放置 */
}

.send-btn[disabled] {
  background-color: #ccc;
}

.empty-state {
  text-align: center;
  padding: 40rpx 20rpx;
  color: #999;
}