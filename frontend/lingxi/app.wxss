/**
 * 全局样式
 */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  text-align: center;
}

.btn-primary {
  background-color: #3cc51f;
  color: white;
  border-radius: 10rpx;
  padding: 20rpx;
  text-align: center;
  margin: 20rpx 0;
  font-size: 32rpx;
}

.btn-secondary {
  background-color: #fff;
  color: #3cc51f;
  border: 2rpx solid #3cc51f;
  border-radius: 10rpx;
  padding: 20rpx;
  text-align: center;
  margin: 20rpx 0;
  font-size: 32rpx;
}

.input-style {
  width: 100%;
  padding: 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 10rpx;
  margin: 20rpx 0;
  font-size: 28rpx;
}

.text-center {
  text-align: center;
}

.text-bold {
  font-weight: bold;
}

.margin-top {
  margin-top: 40rpx;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.justify-between {
  justify-content: space-between;
}

.align-center {
  align-items: center;
}